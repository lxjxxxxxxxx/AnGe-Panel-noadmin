{
  "manifest_version": 3,
  "name": "AnGe-Panel 收藏助手",
  "version": "1.0",
  "description": "将当前网页保存到 AnGe-Panel（网站导航 / 网页收藏）",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "保存到 AnGe-Panel"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
